# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg

# Virtual environment
.venv/
venv/
ENV/

# Environment variables / secrets
.env
.env.local
.env.production

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS files
Thumbs.db
.DS_Store

# Runtime database (generated at runtime)
runtime-db/*.sqlite3

# Storage cache
storage/cache/

# Downloaded documents (user-specific)
downloaded document/

# Output files (generated at runtime)
output/*.json
output/*.txt
output/*.md
output/pdf_compare/
output/playwright/
output/video_assets/

# Test artifacts
test_output.txt
test_results.txt
test_pipeline.txt
test_cam_result.py
e2e_log.txt

# Byte-compiled
*.pyc

# Logs
*.log

# Postman environment files (may contain secrets)
postman/*environment*.json

# Synthetic assets (large generated files)
synthetic-assets/

# Reference docs (local only)
refer/

# Agent customization (local workspace config)
.agents/
